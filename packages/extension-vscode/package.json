{
  "name": "pause-vscode",
  "displayName": "Pause — Think & Refine Prompts",
  "description": "Adaptive prompt clarification, scoring, and model-specific rewriting inside VS Code. Refine any rough prompt before you send it to an AI.",
  "version": "3.1.0",
  "publisher": "MdNafizAhmed",
  "license": "MIT",
  "homepage": "https://pause-murex.vercel.app/",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AuvroIslam/pause-extension.git",
    "directory": "packages/extension-vscode"
  },
  "bugs": {
    "url": "https://github.com/AuvroIslam/pause-extension/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pause",
          "title": "Pause",
          "icon": "media/pause.svg"
        }
      ]
    },
    "views": {
      "pause": [
        {
          "id": "pause.chatView",
          "name": "Refine a Prompt",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "pause.openChat",
        "title": "Pause: Open Chat",
        "category": "Pause"
      },
      {
        "command": "pause.refinePrompt",
        "title": "Pause: Refine a Prompt (Quick Pick)",
        "category": "Pause"
      },
      {
        "command": "pause.refineSelection",
        "title": "Pause: Refine Selected Text as Prompt",
        "category": "Pause"
      }
    ],
    "keybindings": [
      {
        "command": "pause.openChat",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pause.refineSelection",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "pause.assistant",
        "name": "pause",
        "fullName": "Pause",
        "description": "Refine your rough prompt before you send it",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "Pause",
      "properties": {
        "pause.verbosity": {
          "type": "string",
          "enum": [
            "concise",
            "thorough"
          ],
          "default": "concise",
          "description": "How many clarifying questions Pause asks. Concise = up to 3, thorough = up to 5."
        },
        "pause.proxyUrl": {
          "type": "string",
          "default": "https://pause-proxy-seven.vercel.app/api/ai",
          "description": "Endpoint Pause routes AI calls through. No API keys are stored in the extension."
        },
        "pause.targetModel": {
          "type": "string",
          "enum": [
            "chatgpt.com",
            "claude.ai",
            "gemini.google.com",
            "perplexity.ai",
            "grok.com",
            "chat.deepseek.com",
            "chat.mistral.ai",
            "poe.com"
          ],
          "default": "claude.ai",
          "description": "Which AI's prompting conventions to format the improved prompt for."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@pause/core": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0"
  }
}
