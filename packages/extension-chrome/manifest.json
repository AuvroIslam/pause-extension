{
  "manifest_version": 3,
  "name": "Pause — Think & Handoff",
  "version": "3.0.0",
  "description": "Think before you prompt: adaptive clarification, live scoring, and one-click context handoff to another AI when you hit a limit.",
  "homepage_url": "https://pause-murex.vercel.app/",
  "permissions": ["storage"],
  "host_permissions": [
    "https://pause-proxy.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Pause — Think before you prompt"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://x.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
